# ── Kroger Developer API ──────────────────────────────────────
# Register at: https://developer.kroger.com
# Scope needed: product.compact
KROGER_CLIENT_ID=your_client_id_here
KROGER_CLIENT_SECRET=your_client_secret_here

# Your nearest Kroger store's locationId
# Find it by running:
#   curl -H "Authorization: Bearer <token>" \
#     "https://api.kroger.com/v1/locations?filter.zipCode.near=75023&filter.limit=5"
# Use the `locationId` from the nearest result.
# This filters for in-store stocked items (not price — prices are chain-wide).
KROGER_LOCATION_ID=01400376

# ── Supabase ──────────────────────────────────────────────────
# Use the SERVICE ROLE key (not anon) — needed to bypass RLS for seed writes.
# Found in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
